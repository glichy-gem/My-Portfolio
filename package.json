{
  "name": "portfolio",
  "homepage": "https://github.com/glichy-gem/My-Portfolio",
  "description": "Portfolio site for Shivam Yadav",
  "repository": "https://github.com/glichy-gem/My-Portfolio.git",
  "author": "Shivam Yadav",
  "sideEffects": ["**/*.css"],
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "node ./scripts/dev.cjs",
    "start": "wrangler pages dev ./build/client",
    "deploy": "npm run build && wrangler pages deploy ./build/client --project-name portfolio",
    "deploy:pages": "wrangler pages deploy ./build/client"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^2.7.1",
    "@remix-run/cloudflare-pages": "^2.7.1",
    "@remix-run/react": "^2.7.1",
    "framer-motion": "11.0.5",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.161.0",
    "wrangler": "^3.24.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^2.1.1",
    "@remix-run/dev": "^2.7.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.33",
    "postcss-custom-media": "^10.0.2",
    "vite": "^5.1.0",
    "vite-jsconfig-paths": "^2.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
